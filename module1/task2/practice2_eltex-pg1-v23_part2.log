BEGIN { FS=":" }

FNR==NR {
  gname[$3] = $1                   
  if ($4 != "") {
    n = split($4, a, ",")
    for (i=1; i<=n; i++) {
      if (a[i] != "")
        mem[a[i]] = (mem[a[i]] ? mem[a[i]] "," $1 : $1)   
    }
  }
  next
}

$7 == "/usr/sbin/nologin" {
  uid = $3
  user = $1
  gid = $4

  groups = gname[gid]                
  if (user in mem) groups = (groups ? groups "," mem[user] : mem[user])

  print uid ", " user ", " groups
}
AWK
