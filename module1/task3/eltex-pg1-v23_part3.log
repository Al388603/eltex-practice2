$ echo "Hello from file.txt" >> D1/D2/file.txt

$ cat D1/D2/file.txt
Hello from file.txt

$ ln D1/D2/file.txt D1/D2/D3/hard_link

$ ln -s ../file.txt D1/D2/D3/sym_link

$ ls -li D1/D2/file.txt D1/D2/D3/hard_link D1/D2/D3/sym_link
82 -rw-r--r-- 2 eltex-pg1-v23 eltex-pg1-v23 20 Oct 12 14:03 D1/D2/D3/hard_link
83 lrwxrwxrwx 1 eltex-pg1-v23 eltex-pg1-v23 11 Oct 12 14:06 D1/D2/D3/sym_link -> ../file.txt
82 -rw-r--r-- 2 eltex-pg1-v23 eltex-pg1-v23 20 Oct 12 14:03 D1/D2/file.txt

$ readlink D1/D2/D3/sym_link
../file.txt

$ mv D1/D2/file.txt D1/file.txt

$ ls -l D1/file.txt
-rw-r--r-- 2 eltex-pg1-v23 eltex-pg1-v23 20 Oct 12 14:03 D1/file.txt

$ ls -l D1/D2 2>/dev/null
total 4
drwxr-xr-x 2 eltex-pg1-v23 eltex-pg1-v23 4096 Oct 12 14:06 D3

$ cat D1/D2/D3/hard_link
Hello from file.txt

$ cat D1/D2/D3/sym_link
cat: D1/D2/D3/sym_link: No such file or directory

$ ls -l D1/D2/D3/sym_link
lrwxrwxrwx 1 eltex-pg1-v23 eltex-pg1-v23 11 Oct 12 14:06 D1/D2/D3/sym_link -> ../file.txt

ANSWER(8): После перемещения file.txt жесткая ссылка hard_link продолжает работать, потому что указывает на тот же inode (файл не переименовался для inode). Символьная ссылка sym_link хранит путь ../file.txt на старое местоположение: после mv файл переехал в D1, поэтому путь стал неверным и ссылка сломалась.

